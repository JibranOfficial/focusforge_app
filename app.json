{
  "expo": {
    "name": "FocusForge",
    "slug": "focusforge-mobile",
    "owner": "jibicodes",
    "scheme": ["focusforge", "com.focusforge.app"],
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0B1220",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.focusforge.app"
    },
    "android": {
      "package": "com.focusforge.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B1220"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      ["expo-notifications", { "color": "#8B5CF6" }],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#0B1220"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "6a919c6c-1c27-4a0b-8e05-a649fce32d0c"
      }
    }
  }
}